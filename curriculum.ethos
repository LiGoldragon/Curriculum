; Curriculum's own file formats, over the wire types of
; signal-curriculum-nexus.
;
; A source's modules.datom is a ModuleDeclarations: each module's kind,
; subject and versions, and the file holding its text. The roles file is a
; RolesDocument: each role's surface, model, effort and permission, and its
; modules by identity. A workspace projection writes every module into each
; SkillDirectory, rendered for the Target that directory's harness reads,
; and answers a ProjectionCandidate.
Library
[ :signal_curriculum_nexus:[ ModuleIdentity ModuleSubject RepositoryName SourceRevision
                              RoleName Surface ModelId Effort Permission RoleTools RoleCallers ] ]
[ ModuleKind.[ Spirit Intent Vision Knowledge Inquiry Compensation Role Raw ]
  ModuleVersions.Vector<Integer>
  ModuleFile.String
  ModuleDeclaration.{ ModuleKind ModuleSubject ModuleVersions ModuleFile }
  ModuleDeclarations.Vector<ModuleDeclaration>
  SkillDirectory.[ Claude Agents Codex Pi OpenCode ]
  DeploymentDestination.String
  RepositoryRevision.{ RepositoryName SourceRevision }
  PublishedInventoryDigest.String
  PublishedContentDigest.String
  RendererVersion.String
  ProjectionCandidate.{ DeploymentDestination Vector<RepositoryRevision> PublishedInventoryDigest PublishedContentDigest RendererVersion }
  DescriptionModule.ModuleIdentity
  ContextModules.Vector<ModuleIdentity>
  RoleDefinition.{ RoleName Surface ModelId Effort Permission DescriptionModule ContextModules RoleTools RoleCallers }
  Roles.{ Vector<RoleDefinition> }
  RolesDocument.[ Roles ] ]
[]
[]
