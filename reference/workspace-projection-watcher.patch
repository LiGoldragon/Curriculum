+#[test]
+fn watcher_reconciles_file_edits_and_git_pull_candidates() {
+    use curriculum::registry::{SourceConfiguration, workspace::WorkspaceProjectionWatcher};
+    use std::{sync::mpsc, time::Duration};
+    let temp = tempfile::tempdir().unwrap();
+    let roots = roots(temp.path());
+    for (index, root) in roots.iter().enumerate() {
+        fs::create_dir_all(root.join(".git")).unwrap();
+        fs::write(
+            root.join(".git/HEAD"),
+            format!("{}\n", ["a", "b", "c"][index].repeat(40)),
+        )
+        .unwrap();
+    }
+    source(&roots[1], "knowledge/topic.md", "Initial.\n");
+    let refresh = temp.path().join("refresh");
+    fs::write(&refresh, "#!/bin/sh\nexit 0\n").unwrap();
+    use std::os::unix::fs::PermissionsExt;
+    fs::set_permissions(&refresh, fs::Permissions::from_mode(0o700)).unwrap();
+    let configuration = SourceConfiguration {
+        roots: roots.clone(),
+        refresh_program: refresh,
+    };
+    let watcher = WorkspaceProjectionWatcher::new(configuration, temp.path().join("workspace"));
+    let (candidate_tx, candidate_rx) = mpsc::channel();
+    let (cancel_tx, cancel_rx) = tokio::sync::oneshot::channel();
+    let task = std::thread::spawn(move || {
+        let runtime = tokio::runtime::Builder::new_current_thread()
+            .enable_all()
+            .build()
+            .unwrap();
+        runtime.block_on(watcher.run(
+            async move {
+                let _ = cancel_rx.await;
+            },
+            move |candidate| {
+                candidate_tx
+                    .send(candidate)
+                    .map_err(|error| error.to_string())
+            },
+        ))
+    });
+
+    let initial = candidate_rx.recv_timeout(Duration::from_secs(5)).unwrap();
+    fs::write(roots[1].join("knowledge/topic.md"), "Edited module.\n").unwrap();
+    let edited = loop {
+        let candidate = candidate_rx.recv_timeout(Duration::from_secs(5)).unwrap();
+        if candidate.published_content_digest != initial.published_content_digest {
+            break candidate;
+        }
+    };
+    assert_ne!(
+        initial.published_content_digest,
+        edited.published_content_digest
+    );
+    assert_eq!(
+        edited.repository_revision_vector[1].source_revision,
+        "b".repeat(40)
+    );
+
+    fs::write(roots[1].join(".git/HEAD"), format!("{}\n", "d".repeat(40))).unwrap();
+    let pulled = loop {
+        let candidate = candidate_rx.recv_timeout(Duration::from_secs(5)).unwrap();
+        if candidate.repository_revision_vector[1].source_revision == "d".repeat(40) {
+            break candidate;
+        }
+    };
+    assert_eq!(
+        pulled.repository_revision_vector[1].source_revision,
+        "d".repeat(40)
+    );
+    cancel_tx.send(()).unwrap();
+    task.join().unwrap().unwrap();
+}
