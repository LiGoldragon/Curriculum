+    /// Watches the configured authored roots and reconciles candidates after
+    /// source edits or Git pull updates. It never treats a candidate as active.
+    pub struct WorkspaceProjectionWatcher {
+        configuration: super::SourceConfiguration,
+        projector: WorkspaceProjector,
+    }
+
+    impl WorkspaceProjectionWatcher {
+        pub fn new(
+            configuration: super::SourceConfiguration,
+            destination: impl Into<PathBuf>,
+        ) -> Self {
+            Self {
+                configuration,
+                projector: WorkspaceProjector::new(destination),
+            }
+        }
+
+        pub async fn run<C, F>(&self, cancellation: F, mut candidate_ready: C) -> Result<(), String>
+        where
+            C: FnMut(ProjectionCandidate) -> Result<(), String> + Send,
+            F: Future<Output = ()> + Send,
+        {
+            fs::create_dir_all(&self.projector.root).map_err(|error| error.to_string())?;
+            let destination =
+                fs::canonicalize(&self.projector.root).map_err(|error| error.to_string())?;
+            for root in &self.configuration.roots {
+                let root = fs::canonicalize(root).map_err(|error| error.to_string())?;
+                if destination.starts_with(root) {
+                    return Err(
+                        "projection destination may not be inside a watched source root".into(),
+                    );
+                }
+            }
+            let (sender, mut receiver) = tokio::sync::mpsc::unbounded_channel();
+            let callback = sender.clone();
+            let mut watcher =
+                notify::recommended_watcher(move |event: Result<Event, notify::Error>| {
+                    let _ = callback.send(event);
+                })
+                .map_err(|error| error.to_string())?;
+            for root in &self.configuration.roots {
+                watcher
+                    .watch(root, RecursiveMode::Recursive)
+                    .map_err(|error| error.to_string())?;
+            }
+
+            let initial = self
+                .configuration
+                .read()
+                .map_err(|error| error.to_string())?;
+            candidate_ready(
+                self.projector
+                    .project(&initial)
+                    .map_err(|e| e.to_string())?,
+            )?;
+
+            tokio::pin!(cancellation);
+            loop {
+                let event = tokio::select! {
+                    _ = &mut cancellation => return Ok(()),
+                    event = receiver.recv() => event.ok_or_else(|| "source watcher stopped".to_owned())?,
+                };
+                if !relevant(event)? {
+                    continue;
+                }
+                while let Ok(event) = receiver.try_recv() {
+                    let _ = relevant(event)?;
+                }
+                let latest = self
+                    .configuration
+                    .read_current()
+                    .map_err(|error| error.to_string())?;
+                candidate_ready(self.projector.project(&latest).map_err(|e| e.to_string())?)?;
+            }
+        }
+    }
+
+    fn relevant(event: Result<Event, notify::Error>) -> Result<bool, String> {
+        let event = event.map_err(|error| error.to_string())?;
+        Ok(matches!(
+            event.kind,
+            EventKind::Create(_) | EventKind::Modify(_) | EventKind::Remove(_)
+        ))
+    }
+
     impl WorkspaceProjector {
         pub fn new(root: impl Into<PathBuf>) -> Self {
             Self { root: root.into() }
