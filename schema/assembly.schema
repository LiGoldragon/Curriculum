{
  Operation [(Generate GenerationRequest) (Visualize VisualizationRequest)]
  GenerationOutcome [(Generated GenerationReport) (Visualized VisualizationReport)]
  GenerationRequest { SourceRoot WorkspaceRoot ManifestPath GenerationMode }
  VisualizationRequest { SourceRoot WorkspaceRoot ManifestPath }
  SourceRoot Path {| Display AsRef PartialEq |}
  WorkspaceRoot Path {| Display AsRef PartialEq |}
  ManifestPath Path {| Display AsRef PartialEq |}
  GenerationMode [Write Check]
  GenerationReport { GeneratedFiles }
  GeneratedFiles (Vector GeneratedFile)
  GeneratedFile { OutputPath ByteCount }
  VisualizationReport { RoleVisualizations GeneratedOutputVisualizations }
  RoleVisualizations (Vector RoleVisualization)
  RoleVisualization { OutputIdentifier RolePacketCompositions }
  RolePacketCompositions (Vector RolePacketComposition)
  RolePacketComposition { OutputPath OutputSurface Modules }
  GeneratedOutputVisualizations (Vector GeneratedOutputVisualization)
  GeneratedOutputVisualization { OutputPath ByteCount LineCount }
  OutputPath Path {| Display AsRef PartialEq |}
  ByteCount Integer {| Display PartialEq PartialOrd |}
  LineCount Integer {| Display PartialEq PartialOrd |}
  Manifest { OutputPath OutputKind OutputSurface Frontmatter Modules }
  OutputKind [Markdown Nota Toml]
  OutputSurface [Workspace AgentsSkill ClaudeSkill ClaudeAgent CodexAgent PiAgent]
  Frontmatter (Vector FrontmatterEntry)
  FrontmatterEntry { FrontmatterKey FrontmatterValue }
  FrontmatterKey String {| Display AsRef PartialEq |}
  FrontmatterValue String {| Display AsRef PartialEq |}
  ModulePath Path {| Display AsRef PartialEq |}
  Modules (Vector ModulePath)
  ActiveOutputs (Vector ActiveOutput)
  ActiveOutput [(Skill ActiveSkill)]
  ActiveSkill { OutputIdentifier ModuleIdentifier SkillCategory SkillTier TargetSurfaces }
  OutputIdentifier String {| Display AsRef PartialEq Ord |}
  ModuleIdentifier String {| Display AsRef PartialEq Ord |}
  IncludedModules (Vector ModuleIdentifier)
  RoleDescription String {| Display AsRef PartialEq |}
  RoleTargetSurface [ClaudeAgent CodexAgent PiAgent]
  ModelCatalog (Vector ModelCatalogEntry)
  ModelCatalogEntry { ModelIdentifier ProviderSurface AcceptedEffortLevels }
  ModelIdentifier String {| Display AsRef PartialEq Ord |}
  ProviderSurface [Claude ChatGpt]
  AcceptedEffortLevels (Vector EffortLevel)
  EffortLevel [Low Medium High Xhigh]
  RolePermissions (Vector RolePermission)
  RolePermission { RolePermissionIdentifier PermissionBody ToolRestriction }
  RolePermissionIdentifier String {| Display AsRef PartialEq Ord |}
  PermissionBody String {| Display AsRef PartialEq |}
  ToolRestriction [Restricted Unrestricted]
  RoleDepths (Vector RoleDepth)
  RoleDepth { RoleDepthIdentifier ClaudeDepthModel ChatGptDepthModel }
  RoleDepthIdentifier String {| Display AsRef PartialEq Ord |}
  ClaudeDepthModel { ModelIdentifier DepthEffortLevel }
  ChatGptDepthModel { ModelIdentifier DepthEffortLevel }
  DepthEffortLevel (Optional EffortLevel)
  RoleDescriptions (Vector RoleDescriptionCell)
  RoleDescriptionCell { RolePermissionIdentifier RoleDepthIdentifier RoleDescription }
  ModuleDependencies (Vector ModuleDependency)
  UniversalRoleModules (Vector ModuleIdentifier)
  SkillModuleCompositions (Vector SkillModuleComposition)
  SkillModuleComposition { OutputIdentifier IncludedModules }
  ModuleDependency { ModuleIdentifier ModulePath DependencyModules ModuleKind }
  ModuleKind [RuntimeSkill RoleComposition]
  DependencyModules (Vector ModuleIdentifier)
  TargetModuleInsertions (Vector TargetModuleInsertion)
  TargetModuleInsertion { ModuleIdentifier OutputSurface IncludedModules }
  GeneratedRoleOutputs (Vector OutputPath)
  SkillCategory [Architecture Craft Programming Workflow Meta]
  SkillTier [Apex Keystroke Topic Mechanism]
  TargetSurfaces (Vector TargetSurface)
  TargetSurface [AgentsSkill ClaudeSkill]
}
